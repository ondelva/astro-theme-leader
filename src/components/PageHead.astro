---
/*
  The band every page but the home page opens with: a title, an optional line
  under it, and a slot for the mono count line. It is the nameplate band at a
  smaller size, so the inside pages keep the home page's vertical rhythm
  instead of each inventing one.
*/
interface Props {
  title: string;
  lead?: string;
  accent?: number; // the category archive prints its title in the category's colour
}
const { title, lead, accent } = Astro.props;
---

<section class="mx-auto max-w-wide px-4 pt-14 pb-10 md:pt-20 md:pb-12">
  <h1
    class="font-display text-4xl leading-[1.02] tracking-tight md:text-6xl"
    style={accent ? `color: var(--accent-${accent})` : undefined}
  >
    {title}
  </h1>
  {lead && <p class="text-muted mt-5 max-w-content text-lg">{lead}</p>}
  <slot />
</section>

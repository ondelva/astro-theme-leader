---
/*
  The signature. A row is a title on the left, a short label on the right, and
  the hairline that joins them -- the leader of a printed table of contents. The
  rule thickens into the row's accent on hover, so the colour stacks down the
  right edge and the groups become readable without a card or a badge.

  The type size comes from the band around it: title and right label are 1em, so
  a denser band only has to set a smaller font-size on the list.
*/
import { work as workConfig } from '../config';

interface Props {
  href?: string; // a row without one is a heading: the detail page reopening its own row
  title: string;
  right?: string; // category name -- the far end of the leader, and where the colour lives
  accent?: number; // which --accent-N this row belongs to
  lead?: string; // mono column ahead of the title, usually a date
  mark?: string; // a word before the right label (a status), in mono
  sub?: string; // one line under the row
  dim?: boolean; // a product still being built
}
const { href, title, right, accent, lead, mark, sub, dim = false } = Astro.props;

// An archive prints the same row without a link on it; a span keeps the type.
const Tag = href ? 'a' : ('span' as 'a' | 'span');
---

<Tag
  href={href}
  class:list={['row', { dim, ruled: workConfig.leaderRule === 'line' }]}
  style={accent ? `--row-accent: var(--accent-${accent})` : undefined}
>
  <span class="line">
    {lead && (
      <span class="lead" data-pagefind-ignore>
        {lead}
      </span>
    )}
    <span class="title">{title}</span>
    <span class="rule" aria-hidden="true"></span>
    {mark && (
      <span class="mark" data-pagefind-ignore>
        {mark}
      </span>
    )}
    {right && (
      <span class="right" data-pagefind-ignore>
        {right}
      </span>
    )}
  </span>
  {sub && <span class="sub">{sub}</span>}
</Tag>

<style>
  .row {
    --row-accent: var(--foreground);
    display: block;
    padding-block: 0.55em;
    color: var(--foreground);
    text-decoration: none;
  }

  .line {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
  }

  .title {
    font-weight: var(--weight-display);
    letter-spacing: -0.03em;
    transition: color var(--transition-fast);
  }

  /*
    The leader itself. The box is a constant 2px tall with the rule as its
    bottom border, so thickening it on hover moves nothing. An empty flex item
    takes its baseline from the bottom of its border box, which is what sits
    the rule on the baseline of the two labels it joins.
  */
  .rule {
    flex: 1 1 1.5rem;
    min-width: 1rem;
    box-sizing: border-box;
    height: 2px;
    border-block-end: 1px solid var(--border-soft);
    transition:
      border-width var(--transition-fast),
      border-color var(--transition-fast);
  }
  .row:not(.ruled) .rule {
    border-block-end-color: transparent;
  }

  .right {
    color: var(--row-accent);
    font-weight: var(--weight-display);
    letter-spacing: -0.03em;
    text-align: end;
  }

  .lead,
  .mark {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: var(--weight-body);
    color: var(--muted);
  }

  .sub {
    display: block;
    max-width: var(--content-width);
    margin-block-start: 0.15em;
    font-size: 1rem;
    color: var(--muted);
  }

  /*
    'building' reads as a quieter row. It dims to --muted rather than to an
    opacity, which would drag the accent below the AA ratio the tokens are
    checked at; `mark` carries the word so the state is not colour alone.
  */
  .dim .title {
    color: var(--muted);
  }

  /* Scoped to the link: the heading row on a detail page has nothing to hover. */
  a.row:hover .title,
  a.row:focus-visible .title {
    color: var(--row-accent);
  }
  a.ruled:hover .rule,
  a.ruled:focus-visible .rule {
    border-block-end-width: 2px;
    border-block-end-color: var(--row-accent);
  }

  /* Narrow: the leader has nothing to span, so the category moves above the
     title and the date drops below it. */
  @media (width <= 30rem) {
    .line {
      flex-wrap: wrap;
      row-gap: 0.15em;
    }
    .rule {
      display: none;
    }
    .mark,
    .right {
      order: -1;
    }
    .mark:last-child {
      order: 2;
    }
    .title,
    .lead {
      flex-basis: 100%;
    }
    .lead {
      order: 1;
    }

    /*
      A row whose right-hand end is a mark rather than a category -- a contents
      page, a category archive -- has nothing above the title, so the mark would
      be left on a line of its own reading as a stray number. It joins the line
      before it instead: the date line where there is a date, the title where
      there is not.
    */
    .line:has(.mark:last-child) .lead {
      flex-basis: auto;
    }
    .line:has(.mark:last-child):not(:has(.lead)) .title {
      flex-basis: auto;
    }
  }
</style>

---
/*
  The shelf. Same row as the notes list, with the summary under it and the
  category at the far end -- except on a category archive, where the category
  is the page and the far end carries status and year instead.
*/
import LeaderRow from './LeaderRow.astro';
import { categoryOf, workPath, year, type WorkEntry } from '../lib/content';

interface Props {
  items: WorkEntry[];
  right?: 'category' | 'status';
  summary?: boolean;
  class?: string;
}
const { items, right = 'category', summary = true, class: className } = Astro.props;
---

<ul class:list={className}>
  {items.map((item) => {
    const category = categoryOf(item.data.category);
    const building = item.data.status === 'building';
    const status = right === 'status';
    return (
      <li data-status={item.data.status} data-category={item.data.category}>
        <LeaderRow
          href={workPath(item.id)}
          title={item.data.title}
          right={status ? undefined : category.name}
          mark={
            status
              ? `${item.data.status} · ${year(item.data.started)}`
              : building
                ? 'building'
                : undefined
          }
          accent={category.accent}
          sub={summary ? item.data.summary : undefined}
          dim={building}
        />
      </li>
    );
  })}
</ul>

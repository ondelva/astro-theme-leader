---
/*
  Demo-site only: renders nothing unless PUBLIC_DEMO_BUY_URL is set at build time, so a
  buyer's build is unaffected. The strip is the ink inverted, not an accent -- a colour
  here would read as a fifth category. Set it alongside SITE_URL when building the demo.
*/
const href = import.meta.env.PUBLIC_DEMO_BUY_URL;
---

{href && (
  <aside class="bg-foreground text-background">
    <p class="font-mono mx-auto max-w-wide px-4 py-2 text-xs">
      Leader (free) demo ·{' '}
      <a class="text-background" href={href}>
        Get Pro &rarr;
      </a>
    </p>
  </aside>
)}

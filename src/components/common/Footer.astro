---
import { Icon } from 'astro-icon/components';
import { nav, site } from '../../config';

const year = new Date().getUTCFullYear();
// The credit line. Delete it and the <p> it sits in if you would rather not carry it.
const themeRepo = 'https://github.com/ondelva/astro-theme-leader';
---

<footer class="border-border border-t">
  <div class="text-muted mx-auto max-w-wide px-4 pt-10 pb-14 text-sm">
    <p class="max-w-content">{site.description}</p>

    <div class="mt-6 flex flex-wrap items-baseline gap-x-8 gap-y-3">
      {nav.footer.map(({ title, links }) => (
        <nav aria-label={title}>
          <ul class="flex flex-wrap gap-x-5 gap-y-2">
            {links.map(({ label, href }) => (
              <li>
                <a href={href} class="hover:text-foreground">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
      {nav.social.length > 0 && (
        <ul class="flex gap-4">
          {nav.social.map(({ label, href, icon }) => (
            <li>
              <a href={href} class="hover:text-foreground block no-underline" aria-label={label}>
                <Icon name={icon} class="size-5" />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <p class="mt-8 font-mono text-xs">
      © {year} {site.author} ·{' '}
      <a href={themeRepo} class="hover:text-foreground">
        {site.name}
      </a>{' '}
      theme by ondelva
    </p>
  </div>
</footer>

---
/*
  The masthead. On the home page the nameplate is the first thing in the page
  itself, so `nameplate={false}` drops it here rather than printing the site
  name twice; the nav keeps its position either way.
*/
import { features, nav, site } from '../../config';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  nameplate?: boolean;
}
const { nameplate = true } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="bg-background border-border sticky top-0 z-40 border-b">
  <div class="mx-auto flex max-w-wide items-baseline gap-6 px-4 py-3">
    {nameplate && (
      <a href="/" class="font-display text-foreground text-lg tracking-tight no-underline">
        {site.name}
      </a>
    )}
    <nav class="ml-auto" aria-label="Main">
      <ul class="flex items-baseline gap-5 text-sm">
        {nav.header.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrent(href) ? 'page' : undefined}
              class="text-muted hover:text-foreground aria-[current=page]:text-foreground no-underline aria-[current=page]:underline"
              style="text-underline-offset: 0.35em"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    {features.darkMode && <ThemeToggle />}
  </div>
</header>

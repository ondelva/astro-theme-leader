---
// Light/dark switch. The value lands on <html data-theme>, which flips
// color-scheme so every light-dark() token switches with it. No class variant.
// The three words ride on the button, so the script carries no copy of them.
import { useT } from '../../i18n/t';

const t = useT(Astro.currentLocale);
---

<button
  type="button"
  data-theme-toggle
  data-system={t.themeSystem}
  data-light={t.themeLight}
  data-dark={t.themeDark}
  aria-pressed="false"
  class="font-ui text-sm"
>
  <span data-theme-label>{t.themeSystem}</span>
</button>

<script>
  const KEY = 'theme';
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = button?.querySelector('[data-theme-label]');
  const order = ['system', 'light', 'dark'] as const;

  // The choice lives in this variable; localStorage only keeps it for the next page.
  // Reading storage back on every click stalls the button wherever storage throws
  // (cookies blocked, some private modes): each click would start again from 'system'.
  let choice: string = 'system';
  try {
    choice = localStorage.getItem(KEY) ?? 'system';
  } catch {}

  const apply = (value: string) => {
    if (value === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', value);
    if (label) label.textContent = button?.dataset[value] ?? value;
    button?.setAttribute('aria-pressed', String(value === 'dark'));
  };

  apply(choice);
  button?.addEventListener('click', () => {
    choice = order[(order.indexOf(choice as (typeof order)[number]) + 1) % order.length];
    try {
      localStorage.setItem(KEY, choice);
    } catch {}
    apply(choice);
  });
</script>

---
/*
  Every list of notes on the site: the home band, /notes, a product page, a
  category archive. They differ in what sits at the far end of the leader --
  the category, or the reading time on an archive where every row shares one
  category -- and in the type size the surrounding band sets.
*/
import LeaderRow from './LeaderRow.astro';
import { categoryOf, isoDate, notePath, readingTime, type NoteEntry } from '../lib/content';
import { fmt, useT } from '../i18n/t';

interface Props {
  notes: NoteEntry[];
  right?: 'category' | 'reading'; // 'reading' on a page that is already one category
  class?: string; // the band sets the density with a text-* utility
}
const { notes, right = 'category', class: className } = Astro.props;
const t = useT(Astro.currentLocale);
---

<ul class:list={className}>
  {notes.map((note) => {
    const category = categoryOf(note.data.category);
    const reading = right === 'reading';
    return (
      <li>
        <LeaderRow
          href={notePath(note.id)}
          title={note.data.title}
          lead={isoDate(note.data.pubDate)}
          right={reading ? undefined : category.name}
          mark={reading ? fmt(t.minutes, { n: readingTime(note.body) }) : undefined}
          accent={category.accent}
        />
      </li>
    );
  })}
</ul>

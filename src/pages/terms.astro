---
/*
  Placeholder. Replace the body with your own terms before you launch --
  the page exists so the footer link is never a 404.
*/
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { contact, site } from '../config';
---

<Base title="Terms" description={`The terms for using ${site.name}.`} noindex>
  <PageHead title="Terms" lead={`The terms for using ${site.name}.`}>
    <p class="text-muted mt-6 font-mono text-sm">Placeholder — replace before launch.</p>
  </PageHead>

  <section class="border-border border-t">
    <div class="mx-auto max-w-wide px-4 py-12 md:py-16">
      <div class="prose">
        <p>
          The writing on this site is mine and stays mine; quote it with a link back and we have no
          problem. Code published under a licence carries that licence in its own repository, and
          the licence wins wherever it disagrees with this page.
        </p>
        <h2>No warranty</h2>
        <p>
          Everything here is offered as is. The notes describe what worked for me on a particular
          day with a particular stack, which is not the same as advice for your system.
        </p>
        <h2>Questions</h2>
        <p>
          Write to <a href={`mailto:${contact.email}`}>{contact.email}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

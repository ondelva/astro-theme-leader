---
/*
  A row that leads nowhere: the same title, leader and far end as every other
  row on the site, with the status code where the category would be.
*/
import Base from '../layouts/Base.astro';
import LeaderRow from '../components/LeaderRow.astro';
---

<Base title="Page not found" noindex>
  <section class="mx-auto max-w-wide px-4 pt-20 pb-24 md:pt-28 md:pb-32">
    <h1 class="text-3xl md:text-5xl">
      <LeaderRow title="Page not found" right="404" />
    </h1>
    <p class="text-muted mt-6 max-w-content text-lg">
      Nothing is filed under that address. It may have been renamed, or it may never have existed.
    </p>
    <nav class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm" aria-label="Elsewhere">
      <a href="/" class="text-muted hover:text-foreground">
        Home
      </a>
      <a href="/work" class="text-muted hover:text-foreground">
        Work
      </a>
      <a href="/notes" class="text-muted hover:text-foreground">
        Notes
      </a>
    </nav>
  </section>
</Base>

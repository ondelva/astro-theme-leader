---
// Demo-site only: the theme's own CHANGELOG.md at /whats-new, so a visitor can see what each
// release added and follow its links to the demo pages that show it. astro.config.mjs injects the
// route only when PUBLIC_DEMO_BUY_URL is set, so buyer builds never have it. English-only, like
// the demo bar. The changelog's own "# Changelog" heading is hidden: the page sets the title.
import { Content } from '../../CHANGELOG.md';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
---

<Base title="What's new" description="Every release of the theme, newest first.">
  <PageHead title="What's new" lead="Every release of the theme, newest first." />
  <section class="border-border border-t">
    <div class="mx-auto max-w-wide px-4 py-12 md:py-16">
      <div class="prose whats-new">
        <Content />
      </div>
    </div>
  </section>
</Base>

<style>
  .whats-new :global(h1) {
    display: none;
  }
</style>

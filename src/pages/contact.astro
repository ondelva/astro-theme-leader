---
/*
  The form posts straight to a static form service; there is no server here.
  With no endpoint configured the page shows the address instead, because a
  form that silently goes nowhere is worse than no form at all.
*/
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import LeaderRow from '../components/LeaderRow.astro';
import { contact, nav, site } from '../config';

const description = `Get in touch with ${site.author}.`;
---

<Base title="Contact" {description}>
  <PageHead title="Contact" lead={description} />

  <section class="border-border border-t">
    <div class="mx-auto max-w-wide px-4 py-12 md:py-16">
      {contact.endpoint ? (
        <form action={contact.endpoint} method="POST" class="max-w-content">
          {/* The bait every one of these services checks: a field a person never sees
              and a bot fills in anyway. */}
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
          <label class="block">
            <span class="text-muted font-mono text-sm">Your name</span>
            <input type="text" name="name" required autocomplete="name" class="field" />
          </label>
          <label class="mt-6 block">
            <span class="text-muted font-mono text-sm">Your email</span>
            <input type="email" name="email" required autocomplete="email" class="field" />
          </label>
          <label class="mt-6 block">
            <span class="text-muted font-mono text-sm">Message</span>
            <textarea name="message" rows="6" required class="field"></textarea>
          </label>
          <button type="submit" class="send mt-8">
            Send →
          </button>
        </form>
      ) : (
        <>
          <ul class="text-2xl md:text-4xl">
            <li>
              <LeaderRow
                href={`mailto:${contact.email}`}
                title="Email"
                right={contact.email}
                sub="The fastest way to reach me. I read everything and answer most things within a couple of days."
              />
            </li>
            {nav.social.map(({ label, href }) => (
              <li>
                <LeaderRow href={href} title={label} right={new URL(href).host} />
              </li>
            ))}
          </ul>
          <p class="text-muted mt-10 max-w-content font-mono text-sm">
            Theme note: set <code>contact.endpoint</code> in <code>src/config.ts</code> to a
            Formspree or Basin URL and this page renders a form instead.
          </p>
        </>
      )}
    </div>
  </section>
</Base>

<style>
  /* An input is a line to write on, not a box: the same hairline as everything else. */
  .field {
    display: block;
    width: 100%;
    margin-block-start: 0.4rem;
    padding-block: 0.5rem;
    background: transparent;
    border-block-end: 1px solid var(--border);
    color: var(--foreground);
    font: inherit;
  }
  .field:focus {
    border-block-end-color: var(--foreground);
  }
  textarea.field {
    resize: vertical;
  }

  .send {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: var(--weight-display);
    letter-spacing: -0.03em;
    color: var(--foreground);
    cursor: pointer;
  }
  .send:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>

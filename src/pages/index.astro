---
/*
  Home: the nameplate, the shelf, and the recent notes. Three bands, each with
  its own vertical rhythm -- the nameplate gets the most air, the notes the
  least. A band with nothing in it is not rendered at all, so a site with no
  work or no notes yet still reads as a finished page.
*/
import Base from '../layouts/Base.astro';
import NoteList from '../components/NoteList.astro';
import WorkList from '../components/WorkList.astro';
import { getNotes, getWork } from '../lib/content';
import { site } from '../config';
import { useT } from '../i18n/t';

// The shelf is what is on sale now; archived products live at the foot of /work.
const shelf = (await getWork()).filter((w) => w.data.status !== 'archived').slice(0, 5);
const notes = (await getNotes()).slice(0, 5);
const t = useT(Astro.currentLocale);
---

<Base description={site.description} nameplate={false}>
  <section class="mx-auto max-w-wide px-4 pt-20 pb-24 md:pt-28 md:pb-32">
    <h1 class="font-display text-6xl leading-[0.98] tracking-tight md:text-8xl">{site.name}</h1>
    <p class="text-muted mt-6 max-w-content text-lg md:text-xl">{site.description}</p>
  </section>

  {shelf.length > 0 && (
    <section class="border-border border-t">
      <div class="mx-auto max-w-wide px-4 py-14 md:py-20">
        <h2 class="text-muted font-mono text-sm">{t.work}</h2>
        <WorkList items={shelf} class="mt-7 text-2xl md:text-4xl" />
        <p class="mt-9 text-right text-sm">
          <a href="/work" class="text-muted hover:text-foreground">
            {t.allWork} →
          </a>
        </p>
      </div>
    </section>
  )}

  {notes.length > 0 && (
    <section class="border-border border-t">
      <div class="mx-auto max-w-wide px-4 py-10 md:py-14">
        <h2 class="text-muted font-mono text-sm">{t.notes}</h2>
        <NoteList notes={notes} class="mt-5 text-lg md:text-2xl" />
        <p class="mt-7 text-right text-sm">
          <a href="/notes" class="text-muted hover:text-foreground">
            {t.allNotes} →
          </a>
        </p>
      </div>
    </section>
  )}
</Base>

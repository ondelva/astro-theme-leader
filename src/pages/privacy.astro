---
/*
  Placeholder. Replace the body with your own policy before you launch --
  the page exists so the footer link is never a 404.
*/
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { contact, site } from '../config';
---

<Base title="Privacy" description={`How ${site.name} handles your data.`} noindex>
  <PageHead title="Privacy" lead={`How ${site.name} handles your data.`}>
    <p class="text-muted mt-6 font-mono text-sm">Placeholder — replace before launch.</p>
  </PageHead>

  <section class="border-border border-t">
    <div class="mx-auto max-w-wide px-4 py-12 md:py-16">
      <div class="prose">
        <p>
          This site is a set of static pages. It sets no cookies of its own and runs no third-party
          scripts unless you enable analytics in <code>src/config.ts</code>, in which case whatever
          that provider collects is described in their own policy.
        </p>
        <h2>What is collected</h2>
        <p>
          Nothing, unless you send it. If you write to me through the contact page, the form service
          handling that submission receives your name, your email address and your message, and
          passes them to me by email. I keep those messages and nothing else.
        </p>
        <h2>Requests</h2>
        <p>
          Write to <a href={`mailto:${contact.email}`}>{contact.email}</a> to ask what I hold about
          you or to have it deleted.
        </p>
      </div>
    </div>
  </section>
</Base>

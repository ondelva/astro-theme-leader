---
import { Font } from 'astro:assets';
import type { ComponentProps } from 'astro/types';
import '../styles/global.css';
import SEO from '../components/common/SEO.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import Analytics from '../components/common/Analytics.astro';
import DemoBar from '../components/common/DemoBar.astro';
import { site } from '../config';
import { useT } from '../i18n/t';

type Props = ComponentProps<typeof SEO> & {
  /* The home page prints the nameplate itself; everywhere else the header carries it. */
  nameplate?: boolean;
};
const { nameplate, ...seo } = Astro.props;
const locale = Astro.currentLocale ?? site.locale;
const t = useT(locale);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {/* Only the two weights that are always above the fold are preloaded: 200
        sets every heading, 300 every paragraph. 400 and the mono face load on
        demand rather than adding to the first paint. */}
    <Font
      cssVariable="--font-sans-face"
      preload={[
        { weight: 200, style: 'normal' },
        { weight: 300, style: 'normal' },
      ]}
    />
    <Font cssVariable="--font-mono-face" />
    <SEO {...seo} />
    <script is:inline>
      // Before first paint, or the page flashes the system theme.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark')
          document.documentElement.setAttribute('data-theme', saved);
      } catch {}
    </script>
    <Analytics />
  </head>
  <body class="bg-background text-foreground flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-foreground text-background font-ui sr-only z-50 text-sm no-underline focus:fixed focus:top-4 focus:left-4 focus:not-sr-only focus:px-4 focus:py-2"
    >
      {t.skipToContent}
    </a>
    <DemoBar />
    <Header nameplate={nameplate} />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
